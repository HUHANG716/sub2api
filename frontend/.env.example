# Frontend dev server proxies API requests to the locally running Go service.
# Override this only if your Go server listens on a different host or port.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Optional: enable hot reload for the embedded image playground during frontend dev.
# Start third_party/gpt_image_playground on this port, then the main Vite server
# will serve it under same-origin /image-playground-app/.
# VITE_IMAGE_PLAYGROUND_DEV_URL=http://127.0.0.1:5174
